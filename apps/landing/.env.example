# Public URL of the Vue client (CTA on the landing page).
# Production: https://pile-commander.app
NUXT_PUBLIC_CLIENT_URL=http://localhost:5173

# GitHub releases page of the desktop app. /download reads the latest release
# of this repo for its installer buttons and links here for all other files.
# Unset, the landing uses the default below.
# NUXT_PUBLIC_DESKTOP_APP_URL=https://github.com/a-matyukh/pile-commander/releases/latest

# Optional, server only: a GitHub token for the release lookup behind
# /download. Cached for 10 minutes, so the anonymous limit is normally enough.
# NUXT_GITHUB_TOKEN=

# Public URL of the Bun API (pricing waitlist form).
# Production: same host as the client's VITE_BACKEND_URL
NUXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Abuse / DMCA mailbox shown on /support (mailto).
NUXT_PUBLIC_ABUSE_EMAIL=abuse@pile-commander.app

# Who operates the service, printed on /terms and /privacy. Unset, the pages
# show bracketed placeholders — fill these in before the pages go public.
# During the beta a natural person's name is a valid answer.
NUXT_PUBLIC_OPERATOR_NAME=
# Where that person or company is established, e.g. "Poland".
NUXT_PUBLIC_OPERATOR_LOCATION=
# Law that governs the terms and the courts for disputes.
NUXT_PUBLIC_GOVERNING_LAW=

# Search engines. Unset or false keeps the landing out of the index
# (noindex meta + X-Robots-Tag). Set true and redeploy to allow indexing.
NUXT_PUBLIC_ALLOW_INDEXING=false
