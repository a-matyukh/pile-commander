# Supabase — publishable key only: the backend validates the user's JWT
# (getClaims / JWKS) and queries Postgres on their behalf; RLS does the rest.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# service_role is needed ONLY for system tasks: the GC worker (reads the
# blob_deletions queue — RLS with no user-facing policies) and account
# deletion (auth.admin.deleteUser). Never use it for user requests.
SUPABASE_SERVICE_ROLE_KEY=

# Backblaze B2 (S3-compatible API). Visible only to the backend; clients
# receive only short-lived presigned URLs.
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Presigned URL lifetimes in seconds. A download URL is a read capability for
# as long as it lives, so it is short; an upload URL must outlive a slow PUT
# of a max-size file. SET BOTH: each falls back to the legacy single knob
# PRESIGN_TTL_SECONDS, so an environment that carries only that one gives
# downloads the UPLOAD lifetime — a leaked URL reads for an hour instead of
# fifteen minutes, and the egress meter undercounts over the same window.
# PRESIGN_TTL_SECONDS was the ORIGINAL single knob (it predates the split), so
# older environments carry it. It does not need removing: once the two above
# are set they win and it is simply never read. New environments just omit it.
# PRESIGN_PUT_TTL_SECONDS is not free to raise either: it is the floor of the
# orphan grace below, so a longer upload URL also keeps abandoned objects
# around longer.
PRESIGN_GET_TTL_SECONDS=900
PRESIGN_PUT_TTL_SECONDS=3600

# POST /account/delete needs a recent sign-in: the session's newest amr
# timestamp must be younger than this (the client re-enters the password
# right before deleting, so a stolen access token alone cannot wipe an account)
ACCOUNT_DELETE_MAX_AUTH_AGE_SECONDS=600

# Hub preview cap enforced at POST /hub-preview/finalize (the DB refuses
# larger values in record_hub_preview_upload as well — keep them in sync)
HUB_PREVIEW_MAX_BYTES=2097152

# HMAC-SHA256 of the raw POST body for /billing/webhook (hex, header
# x-webhook-signature). Unset → the endpoint returns 503. Beta stub does
# not change plans.
BILLING_WEBHOOK_SECRET=

# POST /auth/send-email (Supabase Auth Send Email hook → Plunk). All four
# unset → the endpoint returns 503; enable the hook in the dashboard only
# after these are set, or signUp fails. Secret is Standard Webhooks
# (`v1,whsec_…` from Auth Hooks). From must be on a verified Plunk domain.
# subscribed is always false — confirm must not opt the contact into campaigns.
SEND_EMAIL_HOOK_SECRET=
PLUNK_SECRET_KEY=
PLUNK_FROM_EMAIL=
PLUNK_FROM_NAME=Pile Commander

# SPA origin used in workspace-invite emails (`/invite/<token>`). Unset →
# POST /workspace/invite still adds registered members but cannot mail pending.
PUBLIC_APP_URL=

# Hub post-moderation mail (src/moderation.ts). Needs Plunk. Digest goes to
# you once a week; owner mail is the auto-hide / make_private queue.
# Unset digest email → weekly letter is skipped. Abuse address is copied
# into owner mail so they can appeal.
ABUSE_EMAIL=abuse@pile-commander.app
MODERATION_DIGEST_EMAIL=
MODERATION_DIGEST_CRON="0 9 * * 1"
MODERATION_MAIL_CRON="* * * * *"

# In-process jobs: GC, orphan reconcile, previews, Hub moderation mail and
# the egress flush. on (the default) is what Render runs. off leaves the HTTP
# routes up and starts none of those jobs — use it for a local process that
# has the production SUPABASE_SERVICE_ROLE_KEY, so it does not delete B2
# objects or send mail beside the deployed backend.
BACKGROUND_WORKERS=on

# GC worker (in-process Bun cron): drains the blob_deletions queue into B2
# deletes. Rows with attempts >= GC_MAX_ATTEMPTS are skipped (dead letter).
# Queue rows younger than GC_MIN_AGE_HOURS are not executed yet: workspace /
# account deletion is instant at the row level, this is the only window in
# which the objects can still be recovered by hand (0 = delete immediately)
GC_CRON="*/5 * * * *"
GC_BATCH_SIZE=100
GC_MAX_ATTEMPTS=25
GC_MIN_AGE_HOURS=24

# Orphan reconciliation (same worker): diffs the B2 bucket against every
# referenced key; unreferenced objects older than the grace period are enqueued
# into blob_deletions. HOURLY by default, because a presigned PUT cannot be
# capped in size (Bun signs no content-length) — how fast this finds an upload
# that was never finalized is the only bound on it. Back to "0 4 * * *" if
# s3.list over the whole bucket gets expensive.
# The effective grace is max(RECONCILE_GRACE_HOURS, PRESIGN_PUT_TTL_SECONDS +
# 30 min): an object cannot be written after its upload URL expires, so past
# that point a managed key with no row is abandoned rather than in flight.
# Raising PRESIGN_PUT_TTL_SECONDS therefore widens this window too.
RECONCILE_CRON="17 * * * *"
RECONCILE_GRACE_HOURS=24

# Public-link egress fair use (src/egress.ts). Bytes presigned for
# non-members of an owner's public boards are counted per UTC day/month
# against billing_accounts.egress_bytes_month (needs SUPABASE_SERVICE_ROLE_KEY;
# without it nothing is counted). EGRESS_ENFORCE picks the live refusals:
#   off       — count and alert only (beta default)
#   file_size — also refuse originals above max_public_file_bytes to visitors
#   all       — plus the per-visitor share and the monthly budget; in
#               production only together with an email to the owner
#               (pricing/stage 1/1/egress.md)
EGRESS_ENFORCE=off
# alert when an owner's bytes today reach this share of the monthly budget
EGRESS_ALERT_DAY_FRACTION=0.25
# one visitor (IPv4 / IPv6 /64) may pull this share of an owner's budget per UTC day
EGRESS_VISITOR_FRACTION=0.05
# ops address for [egress-alert] mail (needs the Plunk env above); unset → log only
EGRESS_ALERT_EMAIL=

# Previews for non-members of public boards (src/derivatives.ts,
# pricing/stage 1/1/Превью.md): thumb.webp for images, poster.jpg for video,
# under deriv/<workspace_id>/<blob_uuid>/ in the same bucket, outside the
# owner quota. Needs SUPABASE_SERVICE_ROLE_KEY. DERIV_ENABLE:
#   off      — no worker
#   generate — the worker fills entry_derivatives; GET /presign still signs
#              originals (measure coverage, B2 size and memory first)
#   serve    — non-members get the ready preview; deploy the client that
#              renders posters BEFORE switching to serve
DERIV_ENABLE=off
DERIV_CRON="*/1 * * * *"
DERIV_BATCH_SIZE=4
# transient failures (storage, network, timeouts) before a blob is a dead
# letter; codec errors are skipped at once and never retried
DERIV_MAX_ATTEMPTS=5
DERIV_RETRY_BACKOFF_MINUTES=60
# a tick starts no new blob after this — keep it under the 25 s SIGTERM deadline
DERIV_TICK_BUDGET_MS=20000
DERIV_IMAGE_EDGE=1600
DERIV_IMAGE_QUALITY=78
# decode guard: RGBA is 4 bytes per pixel, 40 MP ≈ 160 MB (Bun's default,
# 268 MP ≈ 1 GB, would take a small instance down)
DERIV_MAX_PIXELS=40000000
# below the floor the original is served as is; above the ceiling an image
# is not downloaded into the process at all (video is read by range)
DERIV_MIN_SOURCE_BYTES=262144
DERIV_MAX_SOURCE_BYTES=67108864
# video posters through ffmpeg — preinstalled on Render's native runtimes.
# Probed with `ffmpeg -version` at boot; missing → posters stay off, the
# server still starts
DERIV_VIDEO=off
FFMPEG_PATH=ffmpeg
DERIV_POSTER_EDGE=1280
DERIV_POSTER_QUALITY=78
DERIV_POSTER_TIMEOUT_MS=20000
DERIV_POSTER_SEEK_SECONDS=1
DERIV_POSTER_MAX_OUTPUT_BYTES=8388608
# lifetime of the URL ffmpeg reads the original through (not metered)
DERIV_SOURCE_PRESIGN_TTL_SECONDS=120

PORT=3000

# How many proxies sit in front of this process. x-forwarded-for grows left to
# right — every hop APPENDS the address it saw — so the leftmost entry is
# whatever the client sent, including a value it invented. client_ip reads the
# entry this many hops from the RIGHT, which is the one our own edge wrote.
# Render puts exactly one proxy in front, hence 1. Too low and every client
# lands in one shared bucket; too high and the rate limits fall back to the
# socket address for everyone. Getting it wrong is visible immediately: blanket
# 429s, or none at all.
TRUSTED_PROXY_HOPS=1
