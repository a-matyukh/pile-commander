# Supabase project. The publishable key is safe for the client: RLS
# enforces all access (packages/file-manager/src/schema.sql)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# B2 backend gateway (apps/backend): presigned URLs, account deletion
VITE_BACKEND_URL=http://localhost:3000

# Public front host for published workspace links (defaults to the app origin)
VITE_PUBLIC_BASE_URL=

# Landing host that serves /terms and /privacy, and the origin allowed to
# iframe /demo on the marketing hero. Unset, the sign-up form shows no
# legal links, and /demo stays frame-ancestors 'self' (hero falls back to
# the static preview).
VITE_LANDING_URL=

# Cloudflare Turnstile site key: the sign-up form shows the robot check and the
# backend's sign-up hook verifies it (TURNSTILE_SECRET_KEY there). Unset: no check
VITE_TURNSTILE_SITE_KEY=

# Desktop builds only: the storage the app may upload to, as a URL prefix that
# ends with the bucket (several: commas). The Rust upload commands refuse any
# other address (src-tauri/src/presigned_put.rs) and the window may connect to
# that host (desktopCspPlugin.ts). It is read at build time by src-tauri/build.rs
# and never reaches the bundle. CI takes it from the PILE_STORAGE_URLS secret.
# Unset: any bucket on the storage host is accepted, as before
PILE_STORAGE_URLS=https://s3.us-east-005.backblazeb2.com/your-bucket/
