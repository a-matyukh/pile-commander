# Supabase project. The publishable key is safe for the client: RLS
# enforces all access (packages/file-manager/src/schema.sql)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# B2 backend gateway (apps/backend): presigned URLs, account deletion
VITE_BACKEND_URL=http://localhost:3000

# Public front host for published workspace links (defaults to the app origin)
VITE_PUBLIC_BASE_URL=

# Optional override for Hub report / appeal mailto (defaults to abuse@pile-commander.app)
VITE_ABUSE_EMAIL=

# Landing host that serves /terms and /privacy, and the origin allowed to
# iframe /demo on the marketing hero. Unset, the sign-up form shows no
# legal links, and /demo stays frame-ancestors 'self' (hero falls back to
# the static preview).
VITE_LANDING_URL=
