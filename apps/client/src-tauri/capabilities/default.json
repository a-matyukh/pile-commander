{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Everything the window may do except change files: reading the home folder, dialogs, notifications, updates. Writes are in home-writes-<platform>.json. Files are opened by the app's own open_path command, which asks before running a program, so opener:allow-open-path is not granted.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-request-user-attention",
    "core:window:allow-destroy",
    "notification:default",
    "fs:default",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "dialog:default",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/**/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/**/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/**/*"
        }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/**/*"
        }
      ]
    },
    "opener:default",
    "xattrs:default",
    "updater:default",
    "process:default",
    "window-state:default"
  ]
}
